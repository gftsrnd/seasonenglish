{
  "name": "e4s-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "test": "node scripts/run-with-test-postgres.mjs",
    "test:unit": "vitest run",
    "test:db": "node scripts/run-with-test-postgres.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify:media": "node scripts/verify-media-assets.mjs",
    "verify:pronunciation": "node scripts/verify-pronunciation-assets.mjs",
    "verify:app-media": "node scripts/verify-app-media.mjs",
    "build": "pnpm verify:media && pnpm verify:pronunciation && pnpm verify:app-media && pnpm -r build",
    "dev:local": "node scripts/dev-local.mjs",
    "prepare:local-scenarios": "tsx scripts/prepare-local-scenarios.ts",
    "cleanup:local-users": "tsx scripts/cleanup-local-test-users.ts",
    "clean:generated": "node scripts/clean-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "8.23.1",
    "playwright": "^1.64.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
