# Season English – environment variables (copy to .env; .env is git-ignored)
# The current front-end is a no-build static app: every value below is read by server.js
# and exposed to the browser via /config.js as window.__SEASON_CONFIG__ (public values only).
# API keys for AI providers are NOT env vars today: operators enter them in Cài đặt and they
# stay in the browser's localStorage. When the back-end proxies AI calls, move them server-side.

# --- dev server (server.js) ---
PORT=8080
HOST=localhost
APP_ENV=development            # development | staging | production
ORG_NAME=GFT                   # organisation label shown in the app header

# --- back-end integration (to be consumed by the front-end once the API exists) ---
API_BASE_URL=http://localhost:3000/api/v1   # base URL of the REST API described in docs/api-contract.json
API_TIMEOUT_MS=15000

# --- AI proxy (server-side only; never expose to the browser) ---
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=gsk_...
# STT_MODEL=whisper-large-v3-turbo

# --- integrations ---
# BASE_WEBHOOK_URL=https://base.vn/...        # Base Message incoming webhook for study reminders
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
