# Local-only AI provider settings. Copy to .env; never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_PROVIDER=
AI_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS=3
# Rollback baseline for lesson generation; set to strict only after QA.
E4S_LESSON_QUALITY_PROFILE=baseline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
VOCAB_IMAGE_SOURCE=wikimedia
PEXELS_API_KEY=
PIXABAY_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=E4S <no-reply@e4s.gfts.vn>
POSTGRES_PASSWORD=e4s_local_password
MINIO_ROOT_USER=e4s_minio
MINIO_ROOT_PASSWORD=e4s_local_minio_password

# Monthly core-word illustrations (OpenAI Images API). Put your key here; the model id must match OpenAI's docs.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-luna-6
# OPENAI_BASE_URL=https://api.openai.com/v1
# Daily Speaking speech-to-text model (uses OPENAI_API_KEY). Empty = gpt-4o-mini-transcribe; "off" = operator review only.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IMAGE_GENERATION_CONCURRENCY=6
