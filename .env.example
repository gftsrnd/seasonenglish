# E4S environment. Copy to `.env` and fill in the values. Never commit `.env`.
# Full reference: docs/env.md. REQUIRED = docker compose refuses to start, or the feature breaks, without it.

# ── Secrets (REQUIRED; generate your own and keep them out of git) ──────────────
# 32 random bytes, base64. Encrypts provider API keys saved from the Settings screen.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
E4S_SETTINGS_ENCRYPTION_KEY=
# Signs password-reset / PIN-reset codes. Any long random string.
AUTH_OTP_SECRET=
# Database and object storage (used by compose for postgres, minio, api, worker).
POSTGRES_PASSWORD=e4s_local_password
MINIO_ROOT_USER=e4s_minio
MINIO_ROOT_PASSWORD=e4s_local_minio_password

# ── AI text (lessons, coach, grading) ──────────────────────────────────────────
# "anthropic" = use ANTHROPIC_API_KEY below as the default runner. Otherwise the provider/key saved
# per organization in Settings (encrypted with E4S_SETTINGS_ENCRYPTION_KEY) is used.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=
AI_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS=3
# baseline | strict (lesson quality gate)
E4S_LESSON_QUALITY_PROFILE=baseline
# Max AI calls for one monthly resource generation run.
# MONTHLY_RESOURCE_AI_CALL_LIMIT=

# ── OpenAI (vocabulary illustrations + speaking transcription) ──────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-luna-6
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_API=
# OPENAI_IMAGE_QUALITY=
# Empty = gpt-4o-mini-transcribe; "off" = operator review only.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IMAGE_GENERATION_CONCURRENCY=6

# ── Images for vocabulary cards ─────────────────────────────────────────────────
# Passed by compose but not read by the code today (image search tries the free sources in order).
VOCAB_IMAGE_SOURCE=wikimedia
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Listening audio (Edge TTS inside the api container) ────────────────────────
# E4S_ENABLE_EDGE_TTS=true
# EDGE_TTS_COMMAND=edge-tts
# EDGE_TTS_FFMPEG=ffmpeg

# ── Email (password / PIN reset) ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=E4S <no-reply@e4s.gfts.vn>

# ── Web / cookies (set by docker-compose.tunnel.yml for the live site) ─────────
# WEB_ORIGIN=https://e4s.gfts.vn
# COOKIE_SECURE=true
# VITE_API_BASE_URL=            # only when the web is served from another origin than /api
# VITE_E4S_STAFF_DIRECT_ENTRY=1 # staff login entry at /season-english/staff

# ── Host ports (base compose) ─────────────────────────────────────────────────
# E4S_WEB_PORT=4175
# E4S_API_PORT=3001
# E4S_POSTGRES_PORT=5433
# E4S_MINIO_PORT=9002
# E4S_MINIO_CONSOLE_PORT=9003

# ── Worker ─────────────────────────────────────────────────────────────────────
# WORKER_POLL_MS=1000
# WORKER_LEASE_SECONDS=60
# WORKER_ID=

# ── Optional features / local tooling ──────────────────────────────────────────
# E4S_ENABLE_MAINTENANCE=false   # dev-only maintenance endpoints; ignored when NODE_ENV=production
# E4S_REGISTER_TRIAL=            # guard for the 4300-only trial script (value: dev-4300)
# E4S_SEED_SCENARIOS=false       # local demo scenario accounts (never on the live site)
# Demo / scenario logins for local seeding. Keep them only in .env, never in git.
# Unset values are generated at random and printed once by scripts/prepare-local.ts.
E4S_DEMO_LEARNER_PIN=
E4S_DEMO_STAFF_PASSWORD=
E4S_DEMO_MANAGER_PASSWORD=
E4S_SCENARIO_STAFF_PASSWORD=
# E4S_ALLOW_LOCAL_SCENARIOS=false
